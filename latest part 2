/* --------------------Laptop media--------------------- */
.trekker_text{
display: flex;
justify-content: center;
    width: 100%;
}

.mothers_text{
    width: 90%;
}

.trekker_text h2{
    font-size: 30px;
    font-weight: 500;
    color: #000;
}


.trekker_highlight{
    width: 100%;
    height: auto;

    display: flex;
    justify-content: center;
}


.mother_trekker{
    width: 90%;
    height: auto;
    margin-top: 2rem;
    align-items: center;
    display: flex;
    justify-content: space-between;
}


.text_trekk{
    width: 47%;
    align-self: flex-start;
    height: auto;
    background-color: transparent;
    
}




.text_profile{
    display: flex;
    align-items: center;
    gap: 1rem;
}

.prrofile_txt h3{
font-weight: 500;
}



.image_trekker{
    width: 5rem;
    height: 5rem;
    border-radius: 100%;
    background-color: #cccccc41;
}

.profile_artcle article{
    margin-top: 1rem;
    font-size: 15px;
    font-weight: 400;
}


.vido_trekk{
    width: 50%;
    align-self: flex-start;
    height: auto;
    background-color: transparent;
    display: flex;
    justify-content: space-between;
}


.bigger_trekker{
width: 54%;
height: 18rem;
background-color: #cccccc41;
border-radius: 12px;
}


.smaller_trekker{
    width: 43%;
    height: 12rem;
    background-color: #cccccc41;
    border-radius: 12px;
}
   
















