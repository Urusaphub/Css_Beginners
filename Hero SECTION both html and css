/* -----------------Phone starts below-------------------------------- */


.hero_section{
    width: 100%;
    height: auto;

    display: flex;  
    justify-content: center;
    margin-top: 3rem;



}

.hero_mother{
    width: 90%;
    height: auto;

    
}




.top_des h2{
    font-size: 25px;
    font-weight: 500;
}



.tabs{
    width: 100%;
    margin-top: 1rem;
    height: auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    place-items: center;
    row-gap: 1rem;
    
}


.div_tabs{
    width: 90%;
    height: 3rem;
    background-color:#fff;
    border: solid #00000065 1.5px;
    border-radius: 30px;
}



.hero_box{
    width: 100%;
    margin-top: 1rem;

    display: flex;
    justify-content: center;

}


.mother_box{
    width: 100%;
   height: auto;

   display: grid;
  place-items: center;
  grid-template-columns: repeat(2, 1fr);
  row-gap: 1rem;
  
}


.hero_box_slag{
    width: 93%;
    height: 18rem;
    background-color: #cccccc41;
    border-radius: 20px;
}
