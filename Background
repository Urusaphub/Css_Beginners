--------------------------------Html background-----------------------------------------------


    .background{
        width: 100%;
        height: 35rem;
        background-color: #cccccc51;
    }


    .TEXT_part{
        width: 100%;
        height: 35rem;
        background-color: #0000005a;
        position: absolute;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .shop{
        width: 80%;
       
        display: flex;
        align-items: center;
        justify-content:center;
        position: relative;
        top: 8rem;

    }

    .shop h2{
        color: #ffffff;
        font-weight: 400;
        text-shadow: 1px 1px #000;
        font-size: 300px;
    }


    .background-IMAGE{
        width: 100%;
        height: 100%;
    }

    .background-IMAGE img{
        width: 100%;
        height: 100%;
    }
