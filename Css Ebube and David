
@import url('https://fonts.googleapis.com/css2?family=Prompt:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap');


* {
    margin: 0;
    padding: 0;
    outline: 0;
    border: 0;
    text-decoration: none;
    list-style: none;
    box-sizing: border-box;

    font-family: "Prompt", sans-serif;
    font-style: normal;

}




nav{


    width: 100%;
    height: 6rem;
    background-color: #fff;
    box-shadow: 0px 1px 2px rgba(0, 0, 0, 0.187);

position:fixed;
z-index: 10000;
    display: flex;
    justify-content: center;
}


.mother_nav{
    width: 90%;
    padding-left: 0rem;
    padding-right: 0rem;
    height: auto;


    display: flex;
    align-items: center;
    justify-content: space-between;
    
}


.name h2{
    font-size: 30px;
    font-weight: 500;
}



.tag ul{
    display: none;


}





.profile{
    display: flex;
    align-items: center;
    gap: 1rem;
}


.person{display: none;}
.blog{display: none;}

.sign_up{
    width: 8rem;
    height: 3rem;
    border-radius: 30px;
    background-color: #000;

    display: flex;
    align-items: center;
    justify-content: center;
}


.sign_up a{
    color: #fff;
}



.background{
    width: 100%;
    height: auto;


    display: flex;
    justify-content: center;

}

.mother_background{
    width: 90%;
    height: auto;
    background-color: transparent;
    display: grid;
    row-gap: 1rem;
}



.text_bacground{
    width: 100%;
    background-color: transparent;
    height: auto;
    padding-top: 8rem;
}






.text_bacground h1{
    font-size: 36px;
    font-weight: 500;
}


.text_bacground button{
    background-color: #000;
    height: 3rem;
    width: 12rem;
    border-radius: 30px;
    margin-top: 1rem;
}


.text_bacground button a{
    color: #fff;
}







.box_background{
    width:100%;
    background-color:transparent;
    height: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0rem;
}


.box_larger{
    width: 48%;
      background-color:#cccccc41;
      height: 23rem;
      border-radius: 30px;
}

.minor_box{
     width: 45%;
      background-color:transparent;
      height: 23rem;
      display: grid;
      row-gap: 1rem;
}

.box1{
    width:100%;
    height: 100%;
    background-color: #cccccc41;
    border-radius: 30px;
}


.box2{
   width:100%;
    height: 95%;
    border-radius: 30px;
    background-color: #cccccc41; 
}





